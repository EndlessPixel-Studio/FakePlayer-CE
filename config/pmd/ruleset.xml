<?xml version="1.0"?>
<ruleset name="fakeplayer-ce"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        FakePlayer CE 的静态检查规则集（初始版本）。

        采用白名单策略：只启用在 Minecraft / Bukkit 代码库中误报率低、且确实
        能发现真实缺陷的高信噪比规则。其余规则（尤其是风格类，或在本项目里
        大量误报的规则）暂不纳入门禁，避免噪音淹没真正的问题：
          - UseExplicitTypes：项目大量使用 var，属有意风格
          - ConstantsInInterface：配置键接口集中放常量，属有意设计
          - CompareObjectsWithEquals：实体 / 插件实例的同一性比较本就该用 ==，
            在本项目里几乎全部是误报
          - CallSuperInConstructor / ConstructorCallsOverridableMethod：命令与
            Repository 构造器延用 CommandAPI / Guice 框架约定，非缺陷
          - GuardLogStatement / 各类复杂度与命名规则：纯风格，噪音大

        后续可按需在下方逐项追加具体规则。
    </description>

    <!-- 字符串大小写转换未指定 Locale，在 tr_TR 等区域下会产生错误结果 -->
    <rule ref="category/java/errorprone.xml/UseLocaleWithCaseConversions"/>

    <!-- ===== 废弃代码 / 未使用成员检测 ===== -->
    <!-- 以下规则专门用于发现真正的死代码，误报率可控，纳入门禁。 -->
    <!-- 未使用的私有方法：典型的死代码。
         Guice @Provides 方法由 injector 反射调用, 静态分析视为"未使用"属误报,
         已在 FakeplayerModule 对应方法上用 @SuppressWarnings("PMD.UnusedPrivateMethod") 抑制 -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <!-- 未使用的私有字段：死字段（注意 Lombok @Getter/@Data 生成的访问器可能被
         PMD 漏判，出现的误报会在下方按类排除） -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <!-- 未使用的局部变量 -->
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <!-- 对变量赋值后从未读取（死赋值） -->
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
    <!-- 未使用的 import -->
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>
    <!-- 空覆写（只调用 super 且参数一致）：多数属冗余，少数有意保留可见性，
         列为候选人工复核 -->
    <rule ref="category/java/design.xml/UselessOverridingMethod"/>
</ruleset>
